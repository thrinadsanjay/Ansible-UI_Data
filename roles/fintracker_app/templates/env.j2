# {{ ansible_managed }}
# Finance Tracker settings. See env.example in this directory for every option.

FT_ENV=production
FT_BASE_URL={{ fintracker_base_url }}
FT_SESSION_SECRET={{ fintracker_session_secret }}

FT_DEFAULT_ADMIN_USERNAME={{ fintracker_default_admin_username }}
FT_DEFAULT_ADMIN_PASSWORD={{ fintracker_default_admin_password }}
FT_DEFAULT_ADMIN_EMAIL={{ fintracker_default_admin_email }}

FT_MONGO_URI=mongodb://mongodb:27017
FT_MONGO_DB_NAME=fintracker
MONGO_INITDB_DATABASE=fintracker

# Container port 8000, published on the host port the Load Balancer targets.
PORT=8000
FT_PUBLIC_PORT={{ fintracker_app_port }}

FINTRACKER_VERSION={{ fintracker_image_version }}
FT_MONGO_IMAGE_TAG={{ fintracker_mongo_image_tag }}

# MongoDB and mongo-express stay on loopback (reach them through an SSH tunnel).
FT_MONGO_BIND=127.0.0.1
FT_MONGO_EXPRESS_BIND=127.0.0.1
ME_CONFIG_BASICAUTH_PASSWORD={{ fintracker_mongo_express_password }}
{% for key, value in fintracker_extra_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}
